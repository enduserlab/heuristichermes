# MiniMax API credentials (default provider)
# Obtain your key at https://platform.minimax.io/
MINIMAX_API_KEY=your_minimax_api_key_here

# Additional provider credentials (set only for providers you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Optional provider override (defaults to minimax)
HERMES_PROVIDER=minimax

# Optional model override
HERMES_MODEL=MiniMax-M3

# Optional API base URLs
MINIMAX_BASE_URL=https://api.minimax.io/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# XAI_BASE_URL=https://api.x.ai/v1

# Absolute path to your default vault (optional; may be set per-command)
# HERMES_VAULT=/path/to/your/vault
