# MiniMax API credentials
# Obtain your key at https://platform.minimax.io/
MINIMAX_API_KEY=your_minimax_api_key_here

# API base URL (default is the MiniMax OpenAI-compatible endpoint)
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Model to use for chat completions
# Supported values: MiniMax-M3, MiniMax-M2.7, MiniMax-M2.5, MiniMax-M2
HERMES_MODEL=MiniMax-M3

# Absolute path to your default vault (optional; may be set per-command)
# HERMES_VAULT=/path/to/your/vault
